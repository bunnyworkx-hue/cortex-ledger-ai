# Copy to .env and fill in. All variables are read with the AXIOM_ prefix
# by axiom_core.config.AxiomSettings — see packages/axiom-core/axiom_core/config/settings.py.

AXIOM_ENVIRONMENT=dev
AXIOM_SERVICE_NAME=axiom-os

AXIOM_LOG_LEVEL=INFO
# console (human-readable) or json (structured) — prod always forces json
AXIOM_LOG_FORMAT=console

# Supabase Postgres connection string (Session Pooler recommended for
# serverless/dev; Direct connection also works). Found in:
# Supabase project -> Project Settings -> Database -> Connection string.
AXIOM_DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
AXIOM_SUPABASE_URL=https://[PROJECT_REF].supabase.co
AXIOM_SUPABASE_ANON_KEY=
AXIOM_SUPABASE_SERVICE_ROLE_KEY=

# Milestone 7 (Model Gateway).
AXIOM_ANTHROPIC_API_KEY=
AXIOM_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5

# Milestone 8 (Knowledge Gateway). URL of a running Graphify MCP server:
#   graphify-mcp <path-to-graph.json> --transport http
AXIOM_GRAPHIFY_MCP_URL=http://127.0.0.1:8080/mcp

# Milestone 10 (Agent Fabric). Path to a real agency-agents checkout.
AXIOM_AGENCY_AGENTS_PATH=/Users/you/Desktop/agency-agents

# Milestone 13 (Hermes Integration). Path to the real installed `hermes`
# CLI (install: https://hermes-agent.nousresearch.com/install.sh).
# Use an absolute path if ~/.local/bin isn't on the API process's PATH.
AXIOM_HERMES_BIN=hermes
AXIOM_HERMES_DEFAULT_MODEL=anthropic/claude-sonnet-5
